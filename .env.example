# PostgreSQL bağlantısı (Neon: "pooled" bağlantı adresi)
DATABASE_URL="postgresql://kullanici:sifre@host/stunners?sslmode=require"
# Neon: "direct / unpooled" bağlantı adresi (migration için)
DIRECT_URL="postgresql://kullanici:sifre@host/stunners?sslmode=require"
# Oturum çerezlerini imzalamak için uzun rastgele bir metin (en az 32 karakter)
AUTH_SECRET="buraya-uzun-rastgele-bir-metin-yaz"
# İlk Lider hesabı (veritabanı boşken bir kez oluşturulur)
ADMIN_USERNAME="eren"
ADMIN_PASSWORD="guclu-bir-sifre"
ADMIN_CHARACTER="Eren"
